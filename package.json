{
  "name": "gapstars-equipment-desk",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.4",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.10",
    "prisma": "7.10.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.5"
    }
  }
}
